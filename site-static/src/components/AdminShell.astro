---
// Разметка редактора; кнопки, специфичные для сайта, передаются в слот «toolbar».
import '../styles/admin.css';
---

<section class="admin">
  <div class="admin-intro">
    <h1>Редактор content.json</h1>
    <slot name="intro" />
  </div>

  <div class="toolbar">
    <slot name="toolbar" />
    <label class="btn">
      Импорт файла
      <input type="file" id="import" accept=".json,application/json" hidden />
    </label>
    <button type="button" class="btn" id="export">Экспорт файла</button>
  </div>

  <p id="status" class="status" role="status" aria-live="polite"></p>
  <ul id="issues" class="issues" hidden></ul>

  <div class="tabs" role="tablist">
    <button type="button" role="tab" data-tab="form" aria-selected="true">Форма</button>
    <button type="button" role="tab" data-tab="raw" aria-selected="false">JSON</button>
  </div>

  <div id="form" class="je"></div>
  <div id="raw" hidden>
    <textarea id="raw-text" class="raw-text" spellcheck="false" aria-label="Содержимое content.json"></textarea>
  </div>

  <slot />
</section>
