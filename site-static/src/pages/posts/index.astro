---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { label, sortedPosts } from '../../lib/content';

const posts = sortedPosts();
const title = label('allPosts', 'Записи');
---

<Base title={title}>
  <section class="section">
    <h1>{title}</h1>
    {posts.length ? <div class="grid">{posts.map((post) => <PostCard post={post} />)}</div> : <p class="muted">Записей пока нет.</p>}
  </section>
</Base>
