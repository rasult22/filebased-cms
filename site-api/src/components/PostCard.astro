---
import { formatDate, label, url, type Post } from '../lib/content';

interface Props { post: Post }
const { post } = Astro.props;
---

<article class="card post-card">
  {post.date && <time class="meta" datetime={post.date}>{formatDate(post.date)}</time>}
  <h3><a href={url(`/posts/${post.slug}/`)}>{post.title}</a></h3>
  {post.excerpt && <p>{post.excerpt}</p>}
  <a class="more" href={url(`/posts/${post.slug}/`)}>{label('readMore', 'Читать')} →</a>
</article>
