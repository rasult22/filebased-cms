---
import Base from '../../layouts/Base.astro';
import { formatDate, label, paragraphs, sortedPosts, url, type Post } from '../../lib/content';

// По странице на каждый пост из content.json — список путей вычисляется при сборке.
export function getStaticPaths() {
  return sortedPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<Base title={post.title} description={post.excerpt}>
  <article class="post">
    <a class="back" href={url('/posts/')}>← {label('allPosts', 'Все записи')}</a>
    <h1>{post.title}</h1>
    <p class="meta">
      {post.date && <time datetime={post.date}>{formatDate(post.date)}</time>}
      {post.tags?.map((tag) => <span class="tag">{tag}</span>)}
    </p>
    {paragraphs(post.body).map((p) => <p>{p}</p>)}
  </article>
</Base>
