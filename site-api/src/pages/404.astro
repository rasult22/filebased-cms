---
import Base from '../layouts/Base.astro';
import { url } from '../lib/content';
---

<Base title="Страница не найдена" noindex>
  <section class="section">
    <h1>404</h1>
    <p class="muted">Такой страницы нет. Возможно, запись удалили или переименовали.</p>
    <a class="btn" href={url('/')}>На главную</a>
  </section>
</Base>
