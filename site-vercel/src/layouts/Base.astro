---
import '../styles/global.css';
import { builtAt, url } from '../lib/catalog';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  wide?: boolean;
}

const { title, description = 'Обжарочная «Зерно» в Алматы: свежий кофе, дрип-пакеты и аксессуары.', noindex = false, wide = false } = Astro.props;
const pageTitle = title ? `${title} — Зерно` : 'Зерно — обжарочная в Алматы';
const path = Astro.url.pathname;
const nav = [
  { label: 'Главная', href: '/' },
  { label: 'Каталог', href: '/catalog/' },
];
const isCurrent = (href: string) => (href === '/' ? path === url('/') : path.startsWith(url(href)));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href={url('/')}>Зерно</a>
        <nav aria-label="Основное меню">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class:list={['container', { wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <address>
          <span>Алматы, ул. Жибек Жолы, 50</span>
          <a href="mailto:hello@zerno.example">hello@zerno.example</a>
          <a href="tel:+77000000000">+7 700 000 00 00</a>
        </address>
        <p class="build-stamp">
          Каталог собран <time datetime={builtAt.toISOString()}>{builtAt.toLocaleString('ru-RU', { timeZone: 'Asia/Almaty' })}</time>
          · <a href={url('/admin/')}>Админка</a>
        </p>
      </div>
    </footer>
  </body>
</html>
